                : e.tone === 'warn'
                  ? 'border-amber-200 bg-amber-50/60 dark:border-amber-900 dark:bg-amber-950/20'
                  : 'border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900',
            ]}
          >
            <h3
              class:list={[
                'text-sm font-bold uppercase tracking-wider',
                e.tone === 'ok' ? 'text-emerald-700 dark:text-emerald-400'
                  : e.tone === 'warn' ? 'text-amber-700 dark:text-amber-400'
                  : 'text-slate-600 dark:text-slate-400',
              ]}
            >{e.tag}</h3>
            <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
              {e.items.map((i) => (
                <li class="flex gap-2"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-current opacity-40" /><span>{i}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <p class="mt-6 rounded-xl bg-slate-100 p-4 text-sm leading-relaxed text-slate-600 dark:bg-slate-900 dark:text-slate-300">
        <span class="font-semibold text-slate-800 dark:text-slate-200">明确没有核实的：</span>
        EDA 厂商 AI 功能的实际使用率与增量收入拆分；CAD 厂商 AI 功能是否已经单独定价；
        中国 AI-native CAD 的实际项目进度；机器人基础模型市场的真实规模（各家口径差 10 倍以上）。
      </p>
    </div>
  </section>

  <!-- 来源 -->
  <section class="border-t border-slate-200 py-12 dark:border-slate-800">
    <div class="container-prose">
      <h2 class="text-sm font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">数据来源</h2>
      <ul class="mt-4 space-y-2 text-sm text-slate-600 dark:text-slate-400">
        {sources.map((s) => <li>· {s}</li>)}
      </ul>
      <p class="mt-6 text-xs leading-relaxed text-slate-400 dark:text-slate-500">
        本文为公开信息分析，非投资建议。市场规模的第三方口径差异较大，正文中仅作量级参考，不作为推断依据。
      </p>
    </div>
  </section>
</ResearchLayout>
