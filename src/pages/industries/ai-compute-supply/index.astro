---
/**
 * /insights/industries/ai-compute-supply/ — 算力供给的五条主线（2026 Q4 周报）
 *
 * 核心论点：这一周的市场主线从"造不造得出来"转向"谁付钱、付多久、能不能拿到电"；
 *          中国是需求 600 万张、供给给不了，国产替代在加速但还没赚到钱
 * 数据窗口：2026-10-29 ~ 2026-11-05
 * 来源：NVIDIA 官方、路透、三星、TrendForce、各公司三季报、工信部、商务部
 */
import BaseLayout from '../../../layouts/ResearchLayout.astro';

const title = '需求 600 万张，收入 84 亿，现金 −66.64 亿 · Robin Ji';
const description =
  '2026 年 10 月末至 11 月初算力市场周报：英伟达估值逻辑从供给切向现金流、Vera Rubin 量产、Google TPU 首次外售、HBM4 涨价、国产 GPU 三小龙首次单季集体破 10 亿却现金流净流出 66.64 亿。';

/* ---------- 关键数字 ---------- */
const kpis = [
  { metric: '$5.7T → $5.0T', tone: 'down', label: '英伟达市值', detail: '纪录高位约 5.7 万亿美元，11-02 回落至约 5.0 万亿，自高点回撤约 13%' },
  { metric: '600 万张', tone: 'neutral', label: '中国 RTX Pro 5500 需求', detail: '字节、阿里、腾讯三家订购超 300 万张，占总需求约一半；英伟达表示无法保证交付' },
  { metric: '84.45 亿', tone: 'up', label: '国产三小龙前三季营收', detail: '摩尔线程 32.89 亿 + 沐曦 28.24 亿 + 燧原 23.32 亿，首次集体单季破 10 亿' },
  { metric: '−66.64 亿', tone: 'down', label: '同期经营现金流合计', detail: '等于同期收入的 78.9%；预付款 126.22 亿，是收入的 1.49 倍' },
];

/* ---------- 需求缺口 ---------- */
const demand = [
  { name: '中国总需求', v: 600, pct: 100, note: '路透 2026-10-20，含全部买家' },
  { name: '三家大厂订购', v: 300, pct: 50, note: '字节、阿里、腾讯，合计标价超 350 亿美元' },
];

/* ---------- 国产三小龙财务（发散条） ---------- */
const MAX_WAN = 90;
const fin = [
  { name: '前三季营收', v: 84.45, tone: 'up' },
  { name: '扣非净利', v: -6.34, tone: 'down' },
  { name: '经营现金流', v: -66.64, tone: 'down' },
].map((r) => ({ ...r, half: (Math.abs(r.v) / MAX_WAN) * 50 }));

/* ---------- 国产 GPU 三季报 ---------- */
const dragons = [
  { co: '摩尔线程', q3: '15.52 亿', q3yoy: '+1773.92%', ytd: '32.89 亿', ytdyoy: '+319.15%', kf: '−1.31 亿', kfTone: 'down', note: 'Q3 扣非 +2,007 万，上市以来首个主业盈利季度' },
  { co: '沐曦', q3: '15.00 亿', q3yoy: '+367.12%', ytd: '28.24 亿', ytdyoy: '+128.45%', kf: '+2.59 亿', kfTone: 'up', note: 'Q3 扣非 3.08 亿，+261.63%；三家中唯一持续盈利' },
  { co: '燧原', q3: '≈12.12 亿', q3yoy: '—', ytd: '23.32 亿', ytdyoy: '+331.74%', kf: '−7.62 亿', kfTone: 'down', note: '不兼容 CUDA，赌特定负载效率；腾讯持股 20.26% 且为第一大客户' },
  { co: '寒武纪', q3: '—', q3yoy: '—', ytd: '95.26 亿', ytdyoy: '+106.76%', kf: '+35.23 亿', kfTone: 'up', note: '经营现金流仅 +2.28 亿，约为归母净利（37.15 亿）的 6.1%；Q3 单季净流出 0.84 亿' },
  { co: '海光信息', q3: '—', q3yoy: '—', ytd: '149.55 亿', ytdyoy: '+57.58%', kf: '—', kfTone: 'flat', note: '经营现金流 −24.43 亿；营收规模为三小龙合计的 1.77 倍' },
];

/* ---------- 生态路线 ---------- */
const eco = [
  { co: '摩尔线程', arch: 'MUSA / 全功能 GPU', cover: '761 个接口；PyTorch 3,194 个算子全覆盖', cost: '需持续追 CUDA 版本' },
  { co: '沐曦', arch: 'MXMACA', cover: '4,490 个 CUDA 项目，4,173 个跑通（92.94%）', cost: '需持续追 CUDA 版本' },
  { co: '燧原', arch: 'TopsRider（不兼容）', cover: '0 —— 不提供兼容层', cost: '客户承担全部迁移成本' },
  { co: '华为昇腾', arch: 'CANN 全栈自研', cover: '翻译覆盖约 80% CUDA API', cost: '性能损耗 15–20%' },
];

/* ---------- 三情景 ---------- */
const scenarios = [
  { name: '紧但不断', w: '55%', trigger: '稀土新规生效但留许可口子；英伟达维持低配供货', effect: '云上 GPU 价格继续涨；国产份额爬坡；HBM 成本传导到 2027 报价', tone: 'base' },
  { name: '双向卡死', w: '25%', trigger: '稀土全面执行 + 美方反制升级', effect: 'RTX Pro 5500 断供；国产产能跟不上；算力租赁价格跳涨', tone: 'bad' },
  { name: '稀土换芯片', w: '20%', trigger: '11-10 前达成新的"矿产换算力"安排', effect: '合规卡放量；国产替代节奏放缓，但相关标的估值承压', tone: 'good' },
];

/* ---------- 三分法 ---------- */
const triad = [
  { load: '训练', pick: '英伟达为主', why: '生态、数值精度、集群稳定性；国产卡在万亿参数预训练上缺公开验证' },
  { load: '推理', pick: '国产优先', why: '昇腾 / 沐曦 / 燧原均已过盈亏线，性价比成立；燧原 83.79% 收入来自腾讯推理场景' },
  { load: '图形 / 仿真 / 数字孪生', pick: '摩尔线程唯一选项', why: '三家国产中只有它做全功能 GPU，可同时承载渲染、物理仿真与 AI 计算' },
];

/* ---------- 证据边界 ---------- */
const evidence = [
  {
    tag: '一手来源（可直接引用）',
    tone: 'ok',
    items: [
      '国产 GPU 三季报全部数字 —— 各公司 2026 年三季报原文',
      'CUDA 13.5 GA 支持 Vera Rubin —— NVIDIA 官方技术博客，2026-11-04',
      'HBM4 销量翻三倍、DS 事业部毛利率 72%、10 个长期协议 —— 三星 2026-10-29 发布，TrendForce 转述',
      '智能算力 2,592 EFLOPS、同比 +146% —— 工业和信息化部',
      '11 月 10 日稀土出口管制新规生效 —— 中国商务部公告',
    ],
  },
  {
    tag: '媒体报道（二手，需注明出处）',
    tone: 'warn',
    items: [
      '中国 350 亿美元订单、600 万张总需求 —— 路透 2026-10-20 引述两名知情人士；英伟达未确认金额、数量或交付计划',
      'OpenAI 计划采购 Google TPU —— 路透转引 The Information，2026-10-29；双方均未官方确认',
      'Vera Rubin Q4 出货、单柜 576 个 HBM4 stack、约 30 万片晶圆 —— 台媒与券商专题，非英伟达官方披露',
      '9 月习特会延长有限贸易休战、300 亿美元关税削减、建立 AI 对话机制 —— 路透、CNBC 多源一致',
    ],
  },
  {
    tag: '本文判断（无引用，可被推翻）',
    tone: 'note',
    items: [
      '"估值逻辑从供给切向现金流" —— 基于市值回撤幅度与同期财经媒体标题变化，非量化模型',
      '三情景的 55% / 25% / 20% 权重 —— 是权重，不是测量值',
      '训练 / 推理 / 图形三分法 —— 基于四家国产厂商公开产品定位的归纳',
      '"收入是买来的排队号，不是赚来的钱" —— 对现金流与预付款结构的解读',
    ],
  },
];

/* ---------- 来源 ---------- */
const sources = [
  'NVIDIA Technical Blog，CUDA 13.5 Brings NVIDIA Vera Rubin GA Support，2026-11-04',
  'Reuters，OpenAI plans to buy Google AI chips（引述 The Information），2026-10-29',
  'Reuters，ByteDance / Alibaba / Tencent order over 3 million Nvidia RTX Pro 5500，2026-10-20',
  'Reuters / CNBC，Trump–Xi summit：limited trade truce extended，2026-09-25/26',
  'TrendForce，Samsung says HBM share matches DRAM standing as HBM4 sales triple，2026-10-29',
  '三星电子 2026 年第三季度业绩发布，2026-10-29',
  '摩尔线程 2026 年第三季度报告，2026-10-29；投资者关系活动记录表，2026-11-04',
  '沐曦股份、燧原科技、寒武纪、海光信息 2026 年第三季度报告',
  '电子工程专辑《单季收入齐破 12 亿，国产 GPU 三小龙离寒武纪有多远？》，2026-11-02',
  '华为昇腾 950 超节点获 2026 世界互联网大会领先科技奖，2026-11-03',
  '工业和信息化部：截至 2026 年 9 月底智能算力规模数据',
  'UBS 2027 年 AI 支出预测；四大云厂商季度资本开支追踪，2026-11',
  'GYGO，North American GPU Infrastructure Brief（2026-10-26 ~ 11-01）',
];
---

<BaseLayout title={title} description={description} section="industries">
  <section class="border-b border-slate-200/80 bg-gradient-to-b from-slate-50 to-transparent py-16 dark:border-slate-800 dark:from-slate-900/50">
    <div class="container-prose">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-700 dark:text-accent-400">Industry Insight · AI Compute</p>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl dark:text-white">
        需求 600 万张，收入 84 亿，现金 −66.64 亿
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-600 dark:text-slate-300">
        2026 年 10 月末到 11 月初，算力市场的主线已经从
        <span class="font-semibold text-slate-900 dark:text-slate-100">「芯片造不造得出来」</span>
        转向
        <span class="font-semibold text-slate-900 dark:text-slate-100">「谁付钱、付多久、能不能拿到电」</span>。
        中国这一侧的变化更具体：需求 600 万张，供给给不了；国产 GPU 第一次单季集体破 10 亿，
        而同期经营现金流净流出 66.64 亿。
      </p>
      <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">
        数据窗口：2026-10-29 ~ 2026-11-05 · 来源：NVIDIA 官方、路透、三星、TrendForce、各公司三季报、工信部、商务部
      </p>
      <p class="mt-4 text-sm">
        <a href="../china-auto-global/" class="font-semibold text-accent-700 underline underline-offset-4 hover:text-accent-800 dark:text-accent-400">中国汽车：收缩不是饱和 →</a>
        <span class="mx-2 text-slate-400">·</span>
        <a href="../" class="font-semibold text-accent-700 underline underline-offset-4 hover:text-accent-800 dark:text-accent-400">行业全景 →</a>
      </p>
    </div>
  </section>

  <!-- 核心结论 -->
  <section class="py-10">
    <div class="container-prose">
      <p class="rounded-2xl border border-accent-300 bg-accent-50 p-6 text-base font-medium leading-relaxed text-slate-800 dark:border-accent-800 dark:bg-accent-950/30 dark:text-slate-100">
        一句话：<span class="font-bold">国产替代在加速，但还没赚到钱。</span>
        三小龙把当期收入和募来的钱，换成了上游产能的排队资格 ——
        收入是买来的排队号，不是赚来的钱。
      </p>
    </div>
  </section>

  <!-- KPI -->
  <section class="pb-12">
    <div class="container-prose">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {kpis.map((k) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
            <p
              class:list={[
                'font-bold tabular-nums',
                k.metric.length > 8 ? 'text-2xl' : 'text-3xl',
                k.tone === 'up' ? 'text-emerald-600 dark:text-emerald-400'
                  : k.tone === 'down' ? 'text-rose-600 dark:text-rose-400'
                  : 'text-accent-700 dark:text-accent-400',
              ]}
            >{k.metric}</p>
            <p class="mt-2 text-sm font-semibold leading-snug text-slate-900 dark:text-slate-100">{k.label}</p>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-500 dark:text-slate-400">{k.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 一、五条主线 -->
  <section class="border-t border-slate-200 py-12 dark:border-slate-800">
    <div class="container-prose">
      <h2 class="text-2xl font-bold tracking-tight text-slate-950 dark:text-white">一、这一周的五条主线</h2>
      <p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-300">
        同一周里发生的五件事，指向同一个方向：算力市场的稀缺性，正在从芯片转移到别的东西上。
      </p>

      <div class="mt-8 space-y-5">
        <!-- 1 -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
          <div class="flex flex-wrap items-baseline gap-3">
            <span class="text-xs font-bold uppercase tracking-wider text-accent-700 dark:text-accent-400">主线一</span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100">英伟达冲上 5.7 万亿后回落，估值逻辑换了</h3>
          </div>
          <div class="mt-4 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-50 dark:bg-slate-950/50">
                <tr>
                  <th class="px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">时点</th>
                  <th class="px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">股价</th>
                  <th class="px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">市值</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                <tr class="bg-white dark:bg-slate-900">
                  <td class="px-4 py-2.5 font-semibold text-slate-900 dark:text-slate-100">纪录高位</td>
                  <td class="px-4 py-2.5 tabular-nums text-slate-700 dark:text-slate-300">$237.88</td>
                  <td class="px-4 py-2.5 font-bold tabular-nums text-emerald-600 dark:text-emerald-400">约 $5.7 万亿</td>
                </tr>
                <tr class="bg-white dark:bg-slate-900">
                  <td class="px-4 py-2.5 font-semibold text-slate-900 dark:text-slate-100">11-02 收盘</td>
                  <td class="px-4 py-2.5 tabular-nums text-slate-700 dark:text-slate-300">$206.86</td>
                  <td class="px-4 py-2.5 font-bold tabular-nums text-rose-600 dark:text-rose-400">约 $5.0 万亿</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            自高点回撤约 13%。同期多空信息同时存在：UBS 把 2027 年 AI 支出预测上调到
            <span class="font-semibold">1.4 万亿美元</span>；四大云厂商单季资本开支突破
            <span class="font-semibold">2,000 亿美元</span>（去年同期 1,130 亿）；华尔街一致预期 2027 年资本开支
            <span class="font-semibold">9,345 亿美元</span>。
          </p>
          <p class="mt-4 rounded-xl border-l-4 border-accent-500 bg-slate-50 p-4 text-sm font-medium leading-relaxed text-slate-800 dark:bg-slate-950 dark:text-slate-200">
            过去两年买英伟达，买的是「它造多少卖多少」；现在买英伟达，买的是「它的客户还得起钱吗」。
            <span class="font-bold">供给逻辑 → 现金流逻辑，这是估值中枢下移的开始，不是结束。</span>
          </p>
        </div>

        <!-- 2 -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
          <div class="flex flex-wrap items-baseline gap-3">
            <span class="text-xs font-bold uppercase tracking-wider text-accent-700 dark:text-accent-400">主线二</span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100">Vera Rubin 进入量产，平台换代开始</h3>
          </div>
          <ul class="mt-4 space-y-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            <li>· <span class="font-semibold text-slate-900 dark:text-slate-100">CUDA 13.5 GA</span>（11-04）—— production-ready 支持 Vera Rubin</li>
            <li>· GTC Berlin（10-21）首次系统级亮相；Q4 开始出货</li>
            <li>· 单柜 <span class="font-semibold text-slate-900 dark:text-slate-100">576 个 HBM4 stack</span>，约需 30 万片晶圆（券商测算）</li>
          </ul>
          <p class="mt-4 rounded-xl border-l-4 border-amber-500 bg-amber-50/70 p-4 text-sm font-medium leading-relaxed text-slate-800 dark:bg-amber-950/20 dark:text-slate-200">
            平台切换期的规律是：上一代产品的残值会在一到两个季度里塌掉。
            中国能买到的 RTX Pro 5500 是<span class="font-bold">上一代架构的合规降级版</span> ——
            当 Vera Rubin 量产，差距不是缩小，是按代拉开。
          </p>
        </div>

        <!-- 3 -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
          <div class="flex flex-wrap items-baseline gap-3">
            <span class="text-xs font-bold uppercase tracking-wider text-accent-700 dark:text-accent-400">主线三 · 最被低估</span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100">Google TPU 从「自用」变成「卖」</h3>
          </div>
          <ul class="mt-4 space-y-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            <li>· <span class="font-semibold text-slate-900 dark:text-slate-100">10-29：OpenAI 计划采购 Google TPU</span>（路透引述 The Information，双方未官方确认）</li>
            <li>· Oracle 从 2027 年起对外出租 TPU —— TPU 第一次跑在别家云上</li>
            <li>· TD Cowen 测算：2026 下半年 TPU 收入 94 亿美元 → 2027 年 625 亿美元（预测值）</li>
            <li>· 第八代 TPU 8t / 8i 已发布；对外客户近 100 家，含 Anthropic、Apple、Oracle</li>
          </ul>
          <p class="mt-4 rounded-xl border-l-4 border-accent-500 bg-slate-50 p-4 text-sm font-medium leading-relaxed text-slate-800 dark:bg-slate-950 dark:text-slate-200">
            过去三年所有「挑战英伟达」的尝试都失败了，原因不是芯片不够快，是没有 CUDA、没有规模、没有外部渠道。
            TPU 是第一个三样都有的。<span class="font-bold">这不是份额之争，是定价权之争 —— 大客户开始有第二个报价。</span>
          </p>
        </div>

        <!-- 4 -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
          <div class="flex flex-wrap items-baseline gap-3">
            <span class="text-xs font-bold uppercase tracking-wider text-accent-700 dark:text-accent-400">主线四</span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100">HBM 全面紧缺，涨价已写进 2027 的合同</h3>
